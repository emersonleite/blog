---
import Base from '@/templates/Base.astro';
import ComparadorApp from '@/components/comparador/ComparadorApp.vue';

const title = 'Comparador de Investimentos - Renda Fixa';
const description = 'Compare rendimentos entre CDB (com IR) e LCI/LCA/CRI/CRA (sem IR) de forma interativa.';
---

<Base head={{ title, description }}>
  <div class="bg-slate-900">
    <ComparadorApp client:load />
  </div>
</Base>

<style is:global>
  /* Scrollbar discreta apenas para o scroll dos controles laterais */
  .controls-sidebar::-webkit-scrollbar {
    width: 6px;
  }
  .controls-sidebar::-webkit-scrollbar-track {
    background: transparent;
  }
  .controls-sidebar::-webkit-scrollbar-thumb {
    background: #475569; /* slate-600 */
    border-radius: 9999px;
  }
  .controls-sidebar::-webkit-scrollbar-thumb:hover {
    background: #64748b; /* slate-500 */
  }
</style>

